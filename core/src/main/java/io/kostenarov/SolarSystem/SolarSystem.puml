@startuml

class SolarSystem {
    - Bodies: List<Body>
    - sun: Star
    + getBodies(): List<Body>
    + getSun(): Star
    + addBody(body: Body): void
    + removeBody(body: Body): void
}

class BodyActor {
    - object: Body
    + createBody(name: String, mass: double, radius: double): Body
    + deleteBody(body: Body): void
}

class SolarSystemActor {
    - solarSystem: SolarSystem
    + createSolarSystem(): SolarSystem
    + deleteSolarSystem(solarSystem: SolarSystem): void
}

class Body {
    - name: String
    - mass: double
    - radius: double
    + getName(): String
    + getMass(): double
    + getRadius(): double
}

class Star {
    - luminosity: double
    + getLuminosity(): double
}

class Body {
    - distanceFromSun: double
    - moons: List<Moon>
    + getDistanceFromSun(): double
    + getMoons(): List<Moon>
    + addMoon(moon: Moon): void
    + removeMoon(moon: Moon): void
}

class Moon {
    - distanceFromBody: double
    + getName(): String
    + getMass(): double
    + getRadius(): double
    + getDistanceFromBody(): double
}

class KeplerianOrbit {
    - semiMajorAxis: double
    - eccentricity: double
    - inclination: double
    + getSemiMajorAxis(): double
    + getEccentricity(): double
    + getInclination(): double
}

class BarycenterCalculator {
    + calculateBarycenter(body1: Body, body2: Body): Point3D
    + calculateBarycenter(bodies: List<Body>): Point3D
}

SolarSystem "1" o-- "many" Body : contains
SolarSystem "1" o-- "1" Star : has
Body <|-- Star
Body <|-- Body
Body <|-- Moon
Body "1" o-- "many" Moon : has

BodyActor ..> Body : manages
BodyActor ..> Moon : manages
BodyActor ..> Star : manages

SolarSystemActor ..> SolarSystem : manages

BarycenterCalculator ..> Body : uses
KeplerianOrbit ..> Body : describes orbit of
KeplerianOrbit ..> Star : describes orbit of
KeplerianOrbit ..> Moon : describes orbit of

@enduml
